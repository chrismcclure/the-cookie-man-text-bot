# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. `npm start` / `npm run dev` load it automatically
# (via Node's --env-file-if-exists flag).

# Required for the real OpenAI provider. Without this set, the app falls
# back to a stub AI provider in non-production environments (and refuses to
# start in production).
OPENAI_API_KEY=sk-...

# Optional overrides — sensible defaults are used if omitted.
# PORT=3000
# HOST=0.0.0.0
# OPENAI_MODEL=gpt-5.6-luna

# Twilio — required for POST /sms to accept any request. Without both of
# these set, /sms rejects everything (there is no "skip validation" dev
# mode); POST /chat is unaffected either way.
# TWILIO_AUTH_TOKEN=...
#
# The public URL Twilio is configured to POST to (e.g. your tunnel's HTTPS
# URL, no trailing slash) — NOT the internal http://localhost:3000 address
# this app actually listens on. Twilio signs requests using the public URL
# it believes it called, so signature validation must reconstruct that same
# URL rather than trusting this server's own idea of its host/protocol.
# TWILIO_WEBHOOK_BASE_URL=https://your-tunnel-subdomain.example.com
#
# Only needed if a future feature sends outbound messages via the Twilio
# REST API (not required for the current inbound-webhook-reply flow).
# TWILIO_ACCOUNT_SID=AC...
